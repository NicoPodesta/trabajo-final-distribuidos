@startuml image-fetcher
title Actividad · Image Fetcher · Pipeline por réplica

start

while (¿Mensajes de entrada en cola?) is (pedidos / EOFs)
  if (¿Es mensaje de EOF de un filtro?) then (sí)
    :Registrar EOF del filtro;
    if (¿Llegaron EOFs de todos los filtros y no hay pendientes?) then (sí)
      :Emitir EOF de Q2 hacia el Gateway;
      :Confirmar último EOF;
    endif
  else (pedido de imagen)
    :Reservar cupo de descarga;
    if (¿Servidor en pausa por HTTP 429?) then (sí)
      :Resolver de inmediato sin imagen;
    else (no)
      :Descargar imagen a archivo temporal\n(pool de descargadores concurrentes);
      if (¿Descarga exitosa?) then (sí)
        :Leer archivo local y fragmentar en chunks de 64 KiB;
        :Emitir chunks numerados y EOF de imagen por RabbitMQ;
        :Borrar archivo temporal local;
      else (error 404 / fallo de red)
        :Emitir registro vacío (nombre y URL sin imagen);
      endif
    endif
    :Liberar cupo y confirmar mensaje;
  endif
endwhile (cierre ordenado / SIGTERM)

:Cerrar conexiones y limpiar temporales remanentes;
stop

@enduml
