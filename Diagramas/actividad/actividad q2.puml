@startuml
skinparam shadowing false

title Actividad · Q2 · Filtrado, Descarga y Publicación de Imágenes

|Q2 Filter|
start
:Llega batch de artículos (`article_sections`);
:Filtrar artículos históricos (hasta 2020 inclusive)\ncon sección biografía e imagen referenciada;

if (¿Hay artículos que califican?) then (sí)
  :Generar pedidos de descarga (nombre, URL, imagen);
  :Distribuir pedidos por turno (*round-robin*)\nentre las colas de los fetchers (`image_downloads_[i]`);
else (no)
  :No se generan pedidos de descarga;
endif

:Contabilizar batch procesado y confirmar mensaje;

|Image Fetcher|
:Consumir pedido desde `image_downloads_[i]`;
:Reservar cupo en el pool de descargadores concurrentes;

if (¿Host en pausa por rate limit HTTP 429?) then (sí)
  :Resolver de inmediato sin imagen;
else (no)
  :Descargar imagen a archivo temporal en disco\n(timeout 5s, hasta 3 reintentos);
  if (¿Descarga exitosa?) then (sí)
    :Leer archivo local y fragmentar en chunks de hasta 64 KiB;
    :Emitir chunks numerados y EOF de imagen hacia el Gateway;
    :Eliminar archivo temporal local;
  else (error 404 o fallo de red)
    :Emitir fila CSV vacía (nombre y URL sin imagen);
  endif
endif

:Liberar cupo del pool y confirmar mensaje (ACK);
stop

@enduml
