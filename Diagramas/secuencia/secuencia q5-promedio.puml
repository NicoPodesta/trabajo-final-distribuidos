@startuml q5-promedio
title Secuencia · Q5 · Los recientes esperan el promedio

participant "Tokenizer" as T
participant "Q5 Avg Partial" as A
participant "Q5 Avg Aggregator" as G
participant "Q5 Filter" as F
participant "Gateway" as GW

par mientras llegan los artículos
    T -> A : largo de los históricos
else
    T -> F : largo de los recientes
    note right of F : los retiene hasta conocer el promedio
end

T -> A : fin de artículos
A -> G : suma parcial
G -> F : promedio global

F -> GW : recientes retenidos por encima del promedio

loop artículos que llegan después
    T -> F : largo del reciente
    F -> GW : si supera el promedio
end

T -> F : fin de artículos
F -> GW : fin de Q5
@enduml
