@startuml 02a-contenedores-ingesta-metadatos
!include <C4/C4_Container>

AddElementTag("ref", $bgColor="#e0e0e0", $fontColor="#5a5a5a", $borderColor="#9e9e9e", $legendText="detallado en otro diagrama")

title C4 · Contenedores · Cliente, ingesta y consultas sobre metadatos (Q1, Q2)

Person(usuario, "Usuario", "Ejecuta las consultas sobre su dataset")
System_Ext(wikimedia, "API de Wikimedia", "Provee las imágenes de los artículos")

System_Boundary(sistema, "Wikipedia Article Analysis") {
    Container(client, "Client", "", "Lee el dataset línea a línea, lo envía y guarda los resultados de cada consulta")
    Container(gateway, "Gateway", "", "Asigna client_id, publica lotes de artículos y devuelve los resultados al cliente a medida que llegan")
    ContainerQueue(broker, "Message broker", "", "Transporta los mensajes asíncronos entre contenedores")
    Container(parser, "Parser", "", "Parsea los artículos, deriva idioma y año y descarta los campos no usados")
    Container(q1, "Q1 Filter", "", "Selecciona artículos en inglés con año ≤ 2020")
    Container(q2, "Q2 Filter", "", "Selecciona artículos con año ≤ 2020 y sección biography / biographie")
    Container(img, "Image Fetcher", "", "Descarga la imagen de cada biografía seleccionada")
    Container(tokenizer, "Tokenizer", "", "Ver 02b · Consultas sobre texto (Q3, Q4) y 02c · Consulta sobre promedio de palabras (Q5)", $tags="ref")
}

Rel(usuario, client, "Ejecuta con su dataset")
Rel(client, gateway, "Envía artículos y recibe resultados", "TCP, protocolo propio")
Rel(gateway, parser, "Publica lotes de artículos", "Asíncrono, middleware")
Rel(parser, q1, "Publica artículos proyectados", "Asíncrono, middleware")
Rel(parser, q2, "Publica artículos proyectados", "Asíncrono, middleware")
Rel(parser, tokenizer, "Publica artículos proyectados", "Asíncrono, middleware")
Rel(q2, img, "Publica biografías con año ≤ 2020", "Asíncrono, middleware")
Rel(img, wikimedia, "Descarga imágenes", "HTTPS")
Rel(q1, gateway, "Publica resultados de Q1", "Asíncrono, middleware")
Rel(img, gateway, "Publica resultados de Q2", "Asíncrono, middleware")

Lay_D(gateway, broker)

SHOW_LEGEND()
@enduml
