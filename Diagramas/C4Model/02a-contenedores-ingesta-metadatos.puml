@startuml 02a-contenedores-ingesta-metadatos
!include <C4/C4_Container>

AddElementTag("ref", $bgColor="#e0e0e0", $fontColor="#5a5a5a", $borderColor="#9e9e9e", $legendText="detallado en otro diagrama")

title C4 · Contenedores · Ingesta y consultas sobre metadatos (Q1, Q2)

Person(usuario, "Usuario", "Ejecuta las consultas sobre su dataset")
System_Ext(wikimedia, "API de Wikimedia", "Provee las imágenes de los artículos")

System_Boundary(sistema, "Wikipedia Article Analysis") {
    Container(client, "Client", "Go", "Envía el dataset y guarda los resultados de cada consulta")
    Container(gateway, "Gateway", "Go", "Recibe los artículos y devuelve los resultados")
    Container(q1, "Q1 Filter", "Go", "Selecciona los artículos históricos en inglés")
    Container(q2, "Q2 Filter", "Go", "Selecciona las biografías históricas")
    Container(img, "Image Fetcher", "Go", "Obtiene la imagen de cada biografía")
    Container(tokenizer, "Tokenizer", "Go", "Ver 02b (Q3, Q4) y 02c (Q5)", $tags="ref")
}

Rel(usuario, client, "Ejecuta con su dataset")
Rel(client, gateway, "Envía artículos y recibe resultados", "TCP")
Rel(gateway, q1, "Envía artículos", "RabbitMQ")
Rel(gateway, q2, "Envía artículos", "RabbitMQ")
Rel(gateway, tokenizer, "Envía abstracts", "RabbitMQ")
Rel(q2, img, "Envía biografías", "RabbitMQ")
Rel(img, wikimedia, "Descarga imágenes", "HTTPS")
Rel(q1, gateway, "Devuelve resultados de Q1", "RabbitMQ")
Rel(img, gateway, "Devuelve resultados de Q2", "RabbitMQ")

SHOW_LEGEND()
@enduml
