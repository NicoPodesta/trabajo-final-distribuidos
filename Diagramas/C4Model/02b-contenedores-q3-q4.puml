@startuml 02b-contenedores-q3-q4
!include <C4/C4_Container>

AddElementTag("ref", $bgColor="#e0e0e0", $fontColor="#5a5a5a", $borderColor="#9e9e9e", $legendText="detallado en otro diagrama")

title C4 · Contenedores · Consultas sobre texto (Q3, Q4)

System_Boundary(sistema, "Wikipedia Article Analysis") {
    Container(gateway, "Gateway", "Go", "Ver 02a", $tags="ref")
    Container(tokenizer, "Tokenizer", "Go", "Extrae las palabras de cada abstract, sin stopwords")
    Container(q3, "Q3 Vocabulary Join", "Go", "Detecta las palabras presentes en inglés y en francés")
    Container(q4c, "Q4 Word Counter", "Go", "Cuenta en cuántos abstracts aparece cada palabra")
    Container(q4m, "Q4 Top 20 Merger", "Go", "Combina los parciales en el top 20 final")
}

Rel(gateway, tokenizer, "Envía abstracts", "RabbitMQ")
Rel(tokenizer, q3, "Envía palabras por idioma", "RabbitMQ")
Rel(tokenizer, q4c, "Envía palabras", "RabbitMQ")
Rel(q4c, q4m, "Envía su top 20 parcial", "RabbitMQ")
Rel(q3, gateway, "Devuelve resultados de Q3", "RabbitMQ")
Rel(q4m, gateway, "Devuelve resultados de Q4", "RabbitMQ")

SHOW_LEGEND()
@enduml
