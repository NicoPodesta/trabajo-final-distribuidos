@startuml 02c-contenedores-q5
!include <C4/C4_Container>

AddElementTag("ref", $bgColor="#e0e0e0", $fontColor="#5a5a5a", $borderColor="#9e9e9e", $legendText="detallado en otro diagrama")

title C4 · Contenedores · Consulta sobre promedio de palabras (Q5)

System_Boundary(sistema, "Wikipedia Article Analysis") {
    Container(tokenizer, "Tokenizer", "Go", "Ver 02b", $tags="ref")
    Container(gateway, "Gateway", "Go", "Ver 02a", $tags="ref")
    Container(q5a, "Q5 Avg Partial", "Go", "Suma las palabras de los históricos")
    Container(q5g, "Q5 Avg Aggregator", "Go", "Combina los parciales y calcula el promedio")
    Container(q5f, "Q5 Filter", "Go", "Deja pasar los recientes que superan el promedio")
}

Rel(tokenizer, q5a, "Envía la cantidad de palabras de los históricos", "RabbitMQ")
Rel(tokenizer, q5f, "Envía la cantidad de palabras de los recientes", "RabbitMQ")
Rel(q5a, q5g, "Envía su suma parcial", "RabbitMQ")
Rel(q5g, q5f, "Envía el promedio", "RabbitMQ")
Rel(q5f, gateway, "Devuelve resultados de Q5", "RabbitMQ")

SHOW_LEGEND()
@enduml
