flowchart LR
    C(["Client"]) -->|"artículos"| IN["Gateway<br/>ingesta"]

    IN -->|"artículos y fechas"| Q1F["Q1 Filter"]
    IN -->|"artículos y secciones"| Q2F["Q2 Filter"]
    IN -->|"abstracts"| T["Tokenizer"]

    Q2F -->|"artículos con imagen"| IMG["Image Fetcher"]

    T -->|"palabras por idioma"| Q3J["Q3 Vocabulary Join"]
    T -->|"palabras"| Q4C["Q4 Word Counter"]
    Q4C -->|"top 20 parcial"| Q4M["Q4 Top 20 Merger"]

    T -->|"largo de históricos"| Q5A["Q5 Avg Partial"]
    Q5A -->|"suma parcial"| Q5G["Q5 Avg Aggregator"]
    T -->|"largo de recientes"| Q5F["Q5 Filter"]
    Q5G -.->|"promedio"| Q5F

    Q1F -->|"Q1"| OUT["Gateway<br/>entrega"]
    IMG -->|"Q2"| OUT
    Q3J -->|"Q3"| OUT
    Q4M -->|"Q4"| OUT
    Q5F -->|"Q5"| OUT
    OUT -->|"resultados"| C2(["Client"])
