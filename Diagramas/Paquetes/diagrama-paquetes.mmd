---
config:
  theme: base
  themeVariables:
    fontFamily: Arial, sans-serif
    fontSize: 14px
    clusterBkg: '#ffffff'
    clusterBorder: '#aab8c8'
    lineColor: '#687b91'
  flowchart:
    curve: linear
    nodeSpacing: 24
    rankSpacing: 55
    subGraphTitleMargin:
      top: 12
      bottom: 24
---
%% Vista lógica de los paquetes de golang/src.
%% Q1, Q2, Q3, Q4 y Q5 agrupan los paquetes de cada consulta.
%% Las flechas punteadas indican dependencias de código, no flujo de mensajes.
%% Las dependencias desde un grupo resumen la unión de sus importaciones:
%% cada componente usa solamente los paquetes compartidos que necesita.
%% Gateway contiene proyección, sesiones y collector; no son paquetes separados.
%% Los temporales de Q2 son locales; Q5 contiene el subpaquete pending.
flowchart LR
    subgraph APPS["Aplicaciones"]
        direction TB
        CLIENT["«package» Cliente<br/>Parquet, TCP y resultados"]
        LB["«package» Load Balancer<br/>Asignación de Gateways"]
        GW["«package» Gateway<br/>Sesiones, proyección y collector"]
        TOK["«package» Tokenizer<br/>Limpieza y particionado"]
        subgraph QUERIES["Consultas · agrupaciones lógicas"]
            direction TB
            Q1["«package» Q1 - Filter<br/>Idioma y fecha"]
            Q2["«package» Q2 - Filter - Fetcher<br/>Biografías e imágenes"]
            Q3["«package» Q3 - Vocabulary Join<br/>Intersección EN / FR"]
            Q4["«package» Q4 - Counter - Merger<br/>Top 20 de palabras"]
            Q5["«package» Q5 - Avg - Filter<br/>Promedio y artículos recientes"]
        end
    end

    subgraph COMMON["Paquetes compartidos · common"]
        direction TB
        subgraph SUPPORT["Soporte de ejecución"]
            CFG["«package» config<br/>Configuración"]
            LOG["«package» logger<br/>Logs"]
            SHUT["«package» shutdown<br/>Cierre de procesos"]
        end
        subgraph COMMS["Comunicación y finalización"]
            EXT["«package» messageprotocol.external<br/>TCP binario"]
            PUB["«package» resultpublisher<br/>Envío al Gateway"]
            EOF["«package» eofcoordinator<br/>Barrera por lotes"]
            COUNT["«package» eofcounter<br/>Conteo de cierres"]
            INT["«package» messageprotocol.inner<br/>JSON interno"]
            MW["«package» middleware<br/>Colas y exchanges RabbitMQ"]
        end
        subgraph DATA["Contratos de datos"]
            ART["«package» article<br/>Artículos"]
            RES["«package» result<br/>Resultados y chunks"]
        end
        PUB -.-> INT
        PUB -.-> MW
        EOF -.-> MW
        INT -.-> MW
        INT -.-> RES
        EXT -.-> ART
        EXT -.-> RES
    end

    APPS -.->|"usa según el componente"| COMMON

    classDef app fill:#f3f7fc,stroke:#5b7395,color:#233b5a;
    classDef query fill:#edf7f3,stroke:#438d78,color:#244f43;
    classDef communication fill:#eef0f8,stroke:#707796,color:#3c4365;
    classDef support fill:#f6f6f6,stroke:#8a939e,color:#414c59;
    classDef data fill:#fff5dc,stroke:#b18a39,color:#6b5122;
    classDef client fill:#e3f1ff,stroke:#2463a0,stroke-width:3px,color:#183f68;
    class CLIENT client;
    class LB,GW,TOK app;
    class Q1,Q2,Q3,Q4,Q5 query;
    class EXT,INT,PUB,EOF,COUNT,MW communication;
    class CFG,LOG,SHUT support;
    class ART,RES data;
