%% Distribución de nodos conservada respecto de la versión original.
%% SVG/PNG conservan las posiciones; Mermaid usa distribución automática.
%% Ingreso · archivos, clientes y Gateway
flowchart LR
    subgraph GROUP1["Gateway ×G · un proceso por réplica"]
    API(("Socket<br/>TCP/IP"))
    RX(("TCP Handler<br/>del Gateway"))
    GW(("Gateway<br/>Collector"))
    CONN(("Conexiones<br/>client_id ↔ socket<br/>memoria de sesión"))
    SESSION(("Sesiones<br/>resultados y fin<br/>client_id → destino"))
    end
    C1(("Client 1<br/>lee y envía"))
    CC(("Client N<br/>lee y envía"))
    LB(("Load Balancer<br/>round-robin<br/>asigna Gateway"))
    RQ@{ shape: h-cyl, label: "results_&lt;gatewayID&gt;<br/>type, client_id, query_id<br/>resultados / EOF" }
    F1["Archivo de entrada<br/>artículos"]
    FC["Archivo de entrada<br/>artículos"]
    DATES@{ shape: h-cyl, label: "article_dates<br/>Q1" }
    SECTIONS@{ shape: h-cyl, label: "article_sections<br/>Q2" }
    ABSTRACTS@{ shape: h-cyl, label: "abstracts<br/>Q3 · Q4 · Q5" }
    F1 -->|"Artículos"| C1
    FC -->|"Lotes ≤ 100"| CC
    C1 <-->|"Asigna Gateway<br/>Round-robin"| LB
    CC <--> LB
    C1 <-->|"TCP directo<br/>Lotes / resultados"| API
    CC <--> API
    API <-->|"Lotes / ACK"| RX
    RX ---|"Registra client_id<br/>Asocia socket"| CONN
    GW ---|"Cuenta EOF<br/>por consulta y réplica"| SESSION
    RQ -->|"Busca sesión<br/>según client_id"| GW
    GW -->|"Resultados → espera ACK<br/>Fin al cerrar las consultas"| API
    RX -->|"Publica lotes + EOF"| DATES
    RX --> SECTIONS
    RX --> ABSTRACTS
    classDef control fill:#edf7f3,stroke:#438d78,color:#2d475d;
    class C1,RX,GW,CC,LB control;
    classDef boundary fill:#eaf3fd,stroke:#368be6,color:#2d475d;
    class API boundary;
    classDef entity fill:#fff5db,stroke:#cc980c,color:#2d475d;
    class CONN,SESSION entity;
    classDef queue fill:#f0f1f9,stroke:#8582b4,color:#2d475d;
    class RQ,DATES,SECTIONS,ABSTRACTS queue;
    classDef file fill:#fff7e9,stroke:#b88837,color:#2d475d;
    class F1,FC file;
