%% Distribución de nodos conservada respecto de la versión original.
%% SVG/PNG conservan las posiciones; Mermaid usa distribución automática.
%% Q5 · promedio histórico y artículos recientes
flowchart LR
    subgraph GROUP1["Q5 Partial · por réplica"]
    Q5A(("Q5 Avg<br/>Partial · ×N"))
    SUM(("Suma y cantidad<br/>por client_id<br/>memoria"))
    end
    subgraph GROUP2["Q5 Filter · por worker"]
    Q5F(("Q5 Filter<br/>×N"))
    F5["Pendientes por cliente<br/>filter_&lt;id&gt;/&lt;client_id&gt;.jsonl"]
    E5(("Promedio y fin<br/>por client_id<br/>memoria"))
    end
    subgraph GROUP4["Gateway ×G · retorno de resultados"]
    API(("Socket<br/>TCP/IP"))
    RX(("TCP Handler<br/>del Gateway<br/>client_id → socket"))
    SESSION(("Sesiones<br/>client_id → socket<br/>EOF por réplica"))
    GW(("Gateway<br/>Collector"))
    end
    Q5G(("Q5 Avg<br/>Aggregator · ×1"))
    P(("Gateway<br/>×G"))
    T(("Tokenizer<br/>×N"))
    C(("Client<br/>destinatario"))
    OLDQ@{ shape: h-cyl, label: "historical_counts<br/>n_words · year ≤ 2020<br/>1 cola · N consumidores" }
    PARTQ@{ shape: h-cyl, label: "avg_partials<br/>sum, count<br/>1 cola · 1 consumidor" }
    EX["Exchange<br/>q5_average · direct"]
    AQ@{ shape: h-cyl, label: "promedio<br/>client_id, valor entero<br/>1 cola por Q5 Filter" }
    TQ@{ shape: h-cyl, label: "abstracts<br/>url, language,<br/>date_modified, abstract<br/>1 cola · N consumidores" }
    CQ@{ shape: h-cyl, label: "recent_articles<br/>url, n_words · year ≥ 2021<br/>1 cola · N consumidores" }
    RQ@{ shape: h-cyl, label: "results_&lt;gatewayID&gt;<br/>Q5: url, word_count<br/>type, client_id, query_id" }
    P -->|"Lotes + EOF"| TQ
    TQ -->|"Cuenta tokens<br/>Con repetición"| T
    T -->|"Históricos ≤ 2020<br/>n_words"| OLDQ
    OLDQ -->|"Datos / EOF"| Q5A
    Q5A ---|"Acumula suma<br/>y cantidad"| SUM
    Q5A -->|"Parcial + EOF<br/>Cierre por conteo"| PARTQ
    PARTQ -->|"Espera N EOF"| Q5G
    Q5G -->|"Promedio entero<br/>Sin históricos: 0"| EX
    EX -->|"Difunde promedio"| AQ
    AQ -->|"Promedio por cliente"| Q5F
    T -->|"Recientes &gt; 2020<br/>URL y n_words"| CQ
    CQ -->|"Reparte candidatos<br/>Selecciona n_words &gt; promedio"| Q5F
    Q5F <-->|"Pendientes en disco<br/>Lee y borra al filtrar"| F5
    Q5F ---|"Promedio / fin"| E5
    Q5F -->|"URL y word_count<br/>EOF tras procesar pendientes"| RQ
    RQ -->|"N filtros<br/>N EOF"| GW
    GW --- SESSION
    SESSION --- RX
    RX --- API
    API --> C
    GW -->|"Envía resultados; espera ACK · Fin al cerrar las consultas"| API
    classDef control fill:#edf7f3,stroke:#438d78,color:#2d475d;
    class Q5A,Q5G,P,T,Q5F,C,RX,GW control;
    classDef boundary fill:#eaf3fd,stroke:#368be6,color:#2d475d;
    class API boundary;
    classDef entity fill:#fff5db,stroke:#cc980c,color:#2d475d;
    class SUM,E5,SESSION entity;
    classDef queue fill:#f0f1f9,stroke:#8582b4,color:#2d475d;
    class OLDQ,PARTQ,AQ,TQ,CQ,RQ queue;
    classDef file fill:#fff7e9,stroke:#b88837,color:#2d475d;
    class F5 file;
    classDef exchange fill:#f0f1f9,stroke:#8582b4,color:#2d475d;
    class EX exchange;
