%% Distribución de nodos conservada respecto de la versión original.
%% SVG/PNG conservan las posiciones; Mermaid usa distribución automática.
%% Robustez 1 · etapas y comunicación
flowchart LR
    subgraph GROUP1["Gateway ×G · un proceso por réplica"]
    API(("Socket TCP/IP"))
    RX(("TCP Handler<br/>publica lotes"))
    GW(("Gateway<br/>Result Collector"))
    CONN(("Conexiones<br/>client_id ↔ socket<br/>memoria de sesión"))
    SESSION(("Sesiones<br/>resultados y fin<br/>destino · memoria"))
    end
    subgraph GROUP7["Image Fetcher · descarga completa y envío"]
    IMG(("Image Fetcher<br/>×N"))
    IF["Temporal por imagen<br/>descarga completa"]
    HTTP(("HTTP(S)<br/>image_ref"))
    end
    subgraph GROUP8["Q3 · por partición"]
    Q3(("Q3 Vocabulary Join<br/>×K"))
    VSTATE(("Presencias<br/>word → en / fr<br/>enviado: bool<br/>memoria<br/>por client_id"))
    end
    subgraph GROUP9["Q4 Counter · por partición"]
    Q4C(("Q4 Word Counter<br/>×K"))
    CF(("Conteos Q4<br/>word → count<br/>en memoria"))
    end
    subgraph GROUP10["Q5 Partial · por worker"]
    Q5A(("Q5 Avg Partial<br/>×N"))
    SUM(("Suma y cantidad<br/>por client_id<br/>memoria"))
    end
    subgraph GROUP11["Q5 Filter · por worker"]
    Q5F(("Q5 Filter<br/>×N"))
    F5["Pendientes por cliente<br/>filter_&lt;id&gt;/&lt;client_id&gt;.jsonl"]
    U(("Promedio y fin<br/>por client_id<br/>memoria"))
    end
    Q1(("Q1 Filter<br/>×N"))
    LB(("Load Balancer<br/>round-robin<br/>asigna Gateway"))
    Q2(("Q2 Filter<br/>×N"))
    C(("Client 1<br/>lee y envía"))
    CN(("Client N<br/>lee y envía"))
    Q4M(("Q4 Top 20 Merger<br/>×1"))
    T(("Tokenizer<br/>×N"))
    Q5G(("Q5 Avg Aggregator<br/>×1"))
    Q1Q@{ shape: h-cyl, label: "article_dates<br/>language, url, date_modified<br/>1 cola · N workers" }
    Q2Q@{ shape: h-cyl, label: "article_sections<br/>datos de artículo y sections<br/>1 cola · N workers" }
    IQ@{ shape: h-cyl, label: "image_downloads_&lt;i&gt;<br/>name, url, image_ref<br/>1 cola por Fetcher" }
    VQ@{ shape: h-cyl, label: "vocabulary_&lt;k&gt;<br/>word, language<br/>K colas · fnv32a(word)" }
    TQ@{ shape: h-cyl, label: "abstracts<br/>url, language,<br/>date_modified, abstract<br/>1 cola · N workers" }
    WQ@{ shape: h-cyl, label: "word_counts_&lt;i&gt;<br/>word, count<br/>K colas · hash(word)" }
    TOPQ@{ shape: h-cyl, label: "partial_top20<br/>tops por partición<br/>1 cola · 1 worker" }
    OLDQ@{ shape: h-cyl, label: "historical_counts<br/>n_words; year ≤ 2020<br/>1 cola · N workers" }
    PARTQ@{ shape: h-cyl, label: "avg_partials<br/>sum, count<br/>1 cola · 1 worker" }
    AQ@{ shape: h-cyl, label: "promedio<br/>client_id, valor<br/>1 por Q5 Filter" }
    EX["Exchange<br/>q5_average · direct"]
    CQ@{ shape: h-cyl, label: "recent_articles<br/>url, n_words; year ≥ 2021<br/>1 cola · N workers" }
    RQ@{ shape: h-cyl, label: "results_&lt;gatewayID&gt;<br/>type, client_id, query_id<br/>1 por Gateway" }
    FILE1["Archivo de entrada<br/>artículos"]
    FILEC["Archivo de entrada<br/>artículos"]
    WM["Wikimedia"]
    FILE1 -->|"Lotes de artículos"| C
    FILEC -->|"Parquet"| CN
    C <-->|"Asigna Gateway<br/>Round-robin"| LB
    CN <--> LB
    C <-->|"TCP directo"| API
    CN <--> API
    API <-->|"lotes / ACK"| RX
    RX ---|"Registra client_id<br/>Asocia socket"| CONN
    GW ---|"EOF por consulta<br/>y réplica"| SESSION
    GW -->|"Resultados → ACK<br/>Fin al cerrar consultas"| API
    RX -->|"Lotes + EOF"| Q1Q
    RX -->|"Lotes + EOF"| Q2Q
    RX -->|"Abstracts + EOF"| TQ
    TQ -->|"Normaliza y preagrega"| T
    Q1Q -->|"Reparte lotes"| Q1
    Q1 -->|"Inglés ≤ 2020 → URL y fecha<br/>EOF tras cierre coordinado"| RQ
    Q2Q -->|"Biografías ≤ 2020<br/>Con imagen"| Q2
    Q2 -->|"Reparte pedidos<br/>Coordina EOF"| IQ
    IQ -->|"Pedidos / EOF"| IMG
    IMG <-->|"Descarga HTTP"| HTTP
    HTTP <--> WM
    IMG <-->|"Temporal completo<br/>Borra tras enviar"| IF
    IMG -->|"Chunks o fila sin imagen<br/>EOF sin descargas pendientes"| RQ
    T -->|"Pares únicos<br/>Hash por palabra"| VQ
    VQ -->|"Datos / EOF"| Q3
    Q3 ---|"Marca idiomas"| VSTATE
    Q3 -->|"Inglés ∩ francés, sin repetir<br/>EOF tras T Tokenizers"| RQ
    T -->|"Cuenta abstracts<br/>Reparte por hash"| WQ
    WQ -->|"Incrementos"| Q4C
    Q4C <-->|"Suma por palabra"| CF
    Q4C -->|"Top + EOF"| TOPQ
    TOPQ -->|"Espera K EOF"| Q4M
    Q4M -->|"Top 20 global + EOF<br/>count ↓; word ↑"| RQ
    T -->|"Históricos ≤ 2020"| OLDQ
    OLDQ -->|"Lotes + EOF"| Q5A
    Q5A ---|"Suma y cantidad"| SUM
    Q5A -->|"Parcial + EOF"| PARTQ
    PARTQ -->|"Espera N EOF"| Q5G
    Q5G -->|"Promedio entero"| EX
    EX -->|"Difunde"| AQ
    AQ -->|"Promedio"| Q5F
    T -->|"Recientes &gt; 2020<br/>URL y n_words"| CQ
    CQ -->|"Selecciona n_words &gt; promedio"| Q5F
    Q5F <-->|"Guarda pendientes<br/>Lee y borra al filtrar"| F5
    Q5F ---|"Promedio / fin"| U
    Q5F -->|"URL y word_count<br/>EOF tras procesar pendientes"| RQ
    RQ -->|"Busca sesión; cuenta EOF por consulta y réplica"| GW
    classDef control fill:#edf7f3,stroke:#438d78,color:#2d475d;
    class Q1,LB,Q2,IMG,C,RX,GW,Q3,CN,Q4C,Q4M,T,Q5A,Q5G,Q5F control;
    classDef boundary fill:#eaf3fd,stroke:#368be6,color:#2d475d;
    class HTTP,API boundary;
    classDef entity fill:#fff5db,stroke:#cc980c,color:#2d475d;
    class VSTATE,CONN,SESSION,SUM,U,CF entity;
    classDef queue fill:#f0f1f9,stroke:#8582b4,color:#2d475d;
    class Q1Q,Q2Q,IQ,VQ,TQ,WQ,TOPQ,OLDQ,PARTQ,AQ,CQ,RQ queue;
    classDef file fill:#fff7e9,stroke:#b88837,color:#2d475d;
    class IF,FILE1,FILEC,F5 file;
    classDef exchange fill:#f0f1f9,stroke:#8582b4,color:#2d475d;
    class EX exchange;
    classDef actor fill:#ffffff,stroke:#61758b,color:#2d475d;
    class WM actor;
