%% Distribución de nodos conservada respecto de la versión original.
%% SVG/PNG conservan las posiciones; Mermaid usa distribución automática.
%% Q2 · biografías y descarga de imágenes
flowchart LR
    subgraph GROUP1["Image Fetcher · descarga completa y envío"]
    IMG(("Image Fetcher<br/>×N"))
    IF["Temporal por imagen<br/>client_id, image_id<br/>imagen completa"]
    HTTP(("HTTP(S)<br/>image_ref"))
    end
    subgraph GROUP3["Gateway ×G · retorno de resultados"]
    API(("Socket<br/>TCP/IP"))
    RX(("TCP Handler<br/>del Gateway<br/>client_id → socket"))
    SESSION(("Sesiones<br/>client_id → socket<br/>EOF por réplica"))
    GW(("Gateway<br/>Collector"))
    end
    P(("Gateway<br/>×G"))
    Q2(("Q2 Filter<br/>×N"))
    C(("Client<br/>destinatario"))
    Q2Q@{ shape: h-cyl, label: "article_sections<br/>language, name, url,<br/>date_modified, image, sections" }
    IQ@{ shape: h-cyl, label: "image_downloads_&lt;i&gt;<br/>name, url, image_ref<br/>1 cola por Fetcher" }
    RQ@{ shape: h-cyl, label: "results_&lt;gatewayID&gt;<br/>Q2: image_id, seq, last<br/>bytes + metadatos<br/>type, client_id, query_id" }
    WM["Wikimedia<br/>servicio externo"]
    P -->|"Lotes + EOF"| Q2Q
    Q2Q -->|"Reparte lotes"| Q2
    Q2 -->|"Biografías ≤ 2020<br/>Con imagen; round-robin"| IQ
    IQ -->|"Pedidos<br/>+ EOF"| IMG
    IMG <-->|"Temporal completo<br/>Borra tras enviar"| IF
    IMG <-->|"Descarga HTTP"| HTTP
    HTTP <-->|"Bytes / error de origen"| WM
    IMG -->|"Chunks o resultado sin imagen<br/>EOF sin descargas pendientes"| RQ
    RQ -->|"N Fetchers<br/>fetcher_id único"| GW
    GW --- SESSION
    SESSION --- RX
    RX --- API
    API --> C
    GW -->|"Envía resultados; espera ACK · Fin al cerrar las consultas"| API
    classDef control fill:#edf7f3,stroke:#438d78,color:#2d475d;
    class P,Q2,IMG,C,RX,GW control;
    classDef boundary fill:#eaf3fd,stroke:#368be6,color:#2d475d;
    class HTTP,API boundary;
    classDef entity fill:#fff5db,stroke:#cc980c,color:#2d475d;
    class SESSION entity;
    classDef queue fill:#f0f1f9,stroke:#8582b4,color:#2d475d;
    class Q2Q,IQ,RQ queue;
    classDef file fill:#fff7e9,stroke:#b88837,color:#2d475d;
    class IF file;
    classDef actor fill:#ffffff,stroke:#61758b,color:#2d475d;
    class WM actor;
