%% Q2 · biografías y descarga de imágenes
%% Fuente semántica; SVG y PNG usan una distribución fija para conservar legibilidad.
%% Réplicas: se conserva el diseño previsto; la coordinación de cierre aún tiene pendientes.
%% Parser, TCP Handler y Collector pertenecen al mismo proceso Gateway; se muestran en dos vistas.
flowchart LR
    subgraph FETCHER["Image Fetcher · descarga completa y envío de chunks"]
    IMG(("Image Fetcher<br/>×N"))
    IF["Temporal por imagen<br/>client_id, image_id<br/>imagen completa"]
    HTTP(("HTTP(S)<br/>image_ref"))
    end
    subgraph RETURN["Retorno al cliente"]
    RQ@{ shape: h-cyl, label: "results_&lt;gatewayID&gt;<br/>Q2: image_id, seq, last<br/>bytes + metadatos<br/>type, client_id, query_id" }
    subgraph GATEWAY["Gateway ×G · retorno; mismo proceso que la proyección"]
    GW(("Gateway<br/>Collector"))
    SESSION(("Sesiones<br/>client_id → socket<br/>EOF por consulta"))
    RX(("TCP Handler<br/>del Gateway<br/>client_id → socket"))
    API(("Socket<br/>TCP/IP"))
    end
    end
    P(("Parser /<br/>Projector<br/>en Gateway ×G"))
    Q2Q@{ shape: h-cyl, label: "article_sections<br/>language, name, url,<br/>date_modified, image, sections" }
    Q2(("Q2 Filter<br/>×N"))
    IQ@{ shape: h-cyl, label: "image_downloads<br/>name, url, image_ref<br/>1 cola · N consumidores" }
    WM["Wikimedia<br/>servicio externo"]
    C(("Client<br/>destinatario"))
    P --> Q2Q
    Q2Q --> Q2
    Q2 --> IQ
    IQ --> IMG
    IMG <--> IF
    IMG -->|chunks| RQ
    IMG <--> HTTP
    HTTP <--> WM
    RQ --> GW
    GW --- SESSION
    RX --- SESSION
    RX --- API
    GW -->|escritura por sesión| API
    API --> C
    classDef control fill:#edf7f3,stroke:#377964;
    class P,Q2,IMG,GW,RX,C control;
    classDef boundary fill:#eaf3fd,stroke:#397bac;
    class HTTP,API boundary;
    classDef entity fill:#fff5db,stroke:#b6903e;
    class SESSION entity;
    classDef queue fill:#f0f1f9,stroke:#737d9e;
    class Q2Q,IQ,RQ queue;
    classDef exchange fill:#f0f1f9,stroke:#737d9e;
    classDef file fill:#fff7e9,stroke:#ad8242;
    class IF file;
    classDef actor fill:white,stroke:#526579;
    class WM actor;
%% Descarga y envío: Un temporal por (client_id, image_id). Primero descarga la imagen completa; después el mismo Fetcher lee el temporal y publica chunks. No hay un hilo de envío separado.
%% Chunks y metadatos: Publica image_id, seq, last y bytes en results_<gatewayID>. name y url viajan solo en el primer chunk; el encabezado lleva type, client_id y query_id. last identifica el último chunk de la imagen.
%% Borrado y cierre: Tras el envío, cierra y borra el temporal. El EOF Q2 es distinto del último chunk de una imagen. Se conserva la perspectiva de réplicas; su cierre coordinado sigue pendiente.
