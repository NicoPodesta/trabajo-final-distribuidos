%% Distribución de nodos conservada respecto de la versión original.
%% SVG/PNG conservan las posiciones; Mermaid usa distribución automática.
%% Q3 · Palabras compartidas en inglés y francés
flowchart LR
    subgraph GROUP1["Q3 · estado de cada partición"]
    Q3(("Q3 Vocabulary<br/>Join · ×K"))
    E3(("Presencias<br/>word → en / fr<br/>enviado: bool<br/>memoria<br/>por client_id"))
    end
    subgraph GROUP3["Gateway ×G · retorno de resultados"]
    API(("Socket<br/>TCP/IP"))
    RX(("TCP Handler<br/>del Gateway<br/>client_id → socket"))
    SESSION(("Sesiones<br/>client_id → socket<br/>EOF por réplica"))
    GW(("Gateway<br/>Collector"))
    end
    P(("Gateway<br/>×G"))
    T(("Tokenizer<br/>preagrega por lote<br/>×N"))
    C(("Client<br/>destinatario"))
    TQ@{ shape: h-cyl, label: "abstracts<br/>url, language,<br/>date_modified, abstract<br/>1 cola · N consumidores" }
    VQ@{ shape: h-cyl, label: "vocabulary_&lt;k&gt;<br/>(word, language) únicos por lote<br/>K colas · fnv32a(word) % K" }
    RQ@{ shape: h-cyl, label: "results_&lt;gatewayID&gt;<br/>Q3: word<br/>type, client_id, query_id" }
    P -->|"Lotes + EOF"| TQ
    TQ -->|"Normaliza<br/>abstracts"| T
    T -->|"Pares únicos<br/>Hash por palabra"| VQ
    VQ -->|"Datos / EOF"| Q3
    Q3 ---|"Marca idiomas<br/>y enviados"| E3
    Q3 -->|"Inglés ∩ francés, sin repetir<br/>EOF tras T Tokenizers"| RQ
    RQ -->|"K Joins<br/>K EOF"| GW
    GW --- SESSION
    SESSION --- RX
    RX --- API
    API --> C
    GW -->|"Envía resultados; espera ACK · Fin al cerrar las consultas"| API
    classDef control fill:#edf7f3,stroke:#438d78,color:#2d475d;
    class P,T,Q3,C,RX,GW control;
    classDef boundary fill:#eaf3fd,stroke:#368be6,color:#2d475d;
    class API boundary;
    classDef entity fill:#fff5db,stroke:#cc980c,color:#2d475d;
    class E3,SESSION entity;
    classDef queue fill:#f0f1f9,stroke:#8582b4,color:#2d475d;
    class TQ,VQ,RQ queue;
